// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "npm",
            "script": "watch",
            "problemMatcher": {
                "owner": "esbuild",
                "fileLocation": "relative",
                "pattern": [
                    {
                        "regexp": "^✘ \\[ERROR\\] (.*)$",
                        "message": 1
                    },
                    {
                        "regexp": "^\\s+(.*):(\\d+):(\\d+):$",
                        "file": 1,
                        "line": 2,
                        "column": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\[watch\\] build started",
                    "endsPattern": "^\\[watch\\] build finished"
                }
            },
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "unittest",
            "problemMatcher": [],
            "label": "npm: unittest",
            "detail": "node out/test/testRunner.js -c jasmine.unittest.json",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "type": "npm",
            "script": "compile",
            "problemMatcher": "$tsc",
            "label": "npm: compile",
            "detail": "Type check and bundle the extension into dist/"
        },
        {
            "type": "npm",
            "script": "compile-tests",
            "problemMatcher": "$tsc",
            "label": "npm: compile-tests",
            "detail": "Compile the sources and tests into out/"
        },
        {
            "label": "build extension and tests",
            "dependsOn": [
                "npm: compile",
                "npm: compile-tests"
            ],
            "problemMatcher": []
        }
    ]
}